# weewx-rtldavis: the values you edit. docker-compose.yml reads this file; nothing else needs a hand edit.
# scripts/host-setup.sh fills in TZ, PUID and PGID. Copy this to .env by hand if you skip the script.

# Your time zone, so daily rain resets at local midnight. List: timedatectl list-timezones
TZ=America/New_York
# The user that runs the container: `id -u` and `id -g`. Must be able to open the dongle.
PUID=1000
PGID=1000

# Set to 1 only if an LNA is powered through the dongle's bias tee.
BIAS_TEE=0

# --- First start only (needs image v2.2.0 or newer; older images ignore these) ---
# On the first start the image writes these into weewx-data/weewx.conf. After that the file is the
# only truth: changing a line here later does nothing. Edit weewx-data/weewx.conf instead.
# No radio yet? simulator gives made-up weather; delete weewx-data/weewx.conf to switch later.
#WEEWX_DRIVER=simulator
#WEEWX_LOCATION="My Back Yard"
#WEEWX_LATITUDE=40.7
#WEEWX_LONGITUDE=-74.0
#WEEWX_ALTITUDE=120,foot
# Outside the US: EU or NZ. Rain bucket 1 means 0.2 mm. ISS channel 1 is the factory setting.
#RTLDAVIS_BAND=US
#RTLDAVIS_ISS_CHANNEL=1
#RTLDAVIS_RAIN_BUCKET=0
