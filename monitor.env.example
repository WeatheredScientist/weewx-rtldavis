# Copy this file to monitor.env and fill in your values
# Gmail app password: https://myaccount.google.com/apppasswords
# Google issues it as four 4-character groups separated by spaces; paste it
# exactly as shown there, unquoted.
ALERT_FROM=your_gmail@gmail.com
ALERT_TO=your_alert_destination@example.com
GMAIL_PASS=YOUR_GMAIL_APP_PASSWORD

# Optional. What the watchdog may do when the driver stalls; unset means usb_reset.
# Exactly one of these three lowercase values. Anything else is logged at startup
# and treated as none; it never falls back to a reset.
#   usb_reset     Synology NAS default: sudo usb_reset.sh, a USB driver
#                 unbind/rebind at a hardcoded bus path. Do not use it on a
#                 host whose USB layout differs from that path.
#   restart_unit  systemd hosts: restart the weewx unit, which recreates the
#                 container. The monitor's user needs permission to run that
#                 (see REMEDY_UNIT and REMEDY_SYSTEMCTL in weewx_monitor.py).
#   none          detect and email only; never act.
#REMEDY_MODE=usb_reset
